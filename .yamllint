---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

# Vendored subtrees — see exclude_paths in .ansible-lint for why they are not
# ours to lint or reformat.
ignore: |
  .ansible-lint-rules/
  files/entity-renamer/
